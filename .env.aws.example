# AWS Configuration
# Copy this file to .env.local and fill in your AWS values

# AWS Region (e.g., us-east-1, eu-west-1)
NEXT_PUBLIC_AWS_REGION=us-east-1

# AWS Cognito
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# AWS DynamoDB Tables (optional - defaults will be used if not set)
NEXT_PUBLIC_DYNAMODB_USERS_TABLE=chatapp-users
NEXT_PUBLIC_DYNAMODB_CONVERSATIONS_TABLE=chatapp-conversations
NEXT_PUBLIC_DYNAMODB_MESSAGES_TABLE=chatapp-messages
NEXT_PUBLIC_DYNAMODB_FRIENDS_TABLE=chatapp-friends
NEXT_PUBLIC_DYNAMODB_FRIEND_REQUESTS_TABLE=chatapp-friend-requests

# AWS S3
NEXT_PUBLIC_S3_BUCKET=chatapp-uploads

# AWS API Gateway (for REST and WebSocket endpoints)
NEXT_PUBLIC_API_GATEWAY_URL=
NEXT_PUBLIC_WEBSOCKET_URL=

# Firebase Configuration (Keep for fallback if AWS not configured)
# These will be used if AWS values above are not provided
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=