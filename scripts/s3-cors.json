{
    "CORSRules": [
        {
            "AllowedHeaders": ["*"],
            "AllowedMethods": ["GET", "PUT", "POST", "DELETE", "HEAD"],
            "AllowedOrigins": [
                "http://localhost:3000",
                "http://localhost:3001", 
                "http://localhost:3002",
                "https://*.vercel.app",
                "https://*.netlify.app"
            ],
            "ExposeHeaders": ["ETag", "x-amz-server-side-encryption", "x-amz-request-id"],
            "MaxAgeSeconds": 3000
        }
    ]
}