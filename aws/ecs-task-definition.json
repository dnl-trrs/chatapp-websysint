{
  "family": "chatapp-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "chatapp",
      "image": "{{ECR_IMAGE_URI}}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        }
      ],
      "environment": [
        {
          "name": "NEXT_PUBLIC_AWS_REGION",
          "value": "us-east-2"
        },
        {
          "name": "NEXT_PUBLIC_DYNAMODB_USERS_TABLE",
          "value": "chatapp-users"
        },
        {
          "name": "NEXT_PUBLIC_DYNAMODB_CONVERSATIONS_TABLE",
          "value": "chatapp-conversations"
        },
        {
          "name": "NEXT_PUBLIC_DYNAMODB_MESSAGES_TABLE",
          "value": "chatapp-messages"
        },
        {
          "name": "NEXT_PUBLIC_DYNAMODB_FRIENDS_TABLE",
          "value": "chatapp-friends"
        },
        {
          "name": "NEXT_PUBLIC_DYNAMODB_FRIEND_REQUESTS_TABLE",
          "value": "chatapp-friend-requests"
        }
      ],
      "secrets": [
        {
          "name": "NEXT_PUBLIC_COGNITO_USER_POOL_ID",
          "valueFrom": "arn:aws:secretsmanager:{{AWS_REGION}}:{{AWS_ACCOUNT_ID}}:secret:chatapp/aws-config:NEXT_PUBLIC_COGNITO_USER_POOL_ID::"
        },
        {
          "name": "NEXT_PUBLIC_COGNITO_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:{{AWS_REGION}}:{{AWS_ACCOUNT_ID}}:secret:chatapp/aws-config:NEXT_PUBLIC_COGNITO_CLIENT_ID::"
        },
        {
          "name": "NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID",
          "valueFrom": "arn:aws:secretsmanager:{{AWS_REGION}}:{{AWS_ACCOUNT_ID}}:secret:chatapp/aws-config:NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID::"
        },
        {
          "name": "NEXT_PUBLIC_S3_BUCKET",
          "valueFrom": "arn:aws:secretsmanager:{{AWS_REGION}}:{{AWS_ACCOUNT_ID}}:secret:chatapp/aws-config:NEXT_PUBLIC_S3_BUCKET::"
        },
        {
          "name": "NEXT_PUBLIC_API_GATEWAY_URL",
          "valueFrom": "arn:aws:secretsmanager:{{AWS_REGION}}:{{AWS_ACCOUNT_ID}}:secret:chatapp/aws-config:NEXT_PUBLIC_API_GATEWAY_URL::"
        },
        {
          "name": "NEXT_PUBLIC_WEBSOCKET_URL",
          "valueFrom": "arn:aws:secretsmanager:{{AWS_REGION}}:{{AWS_ACCOUNT_ID}}:secret:chatapp/aws-config:NEXT_PUBLIC_WEBSOCKET_URL::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/chatapp",
          "awslogs-region": "{{AWS_REGION}}",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:3000/ || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::{{AWS_ACCOUNT_ID}}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::{{AWS_ACCOUNT_ID}}:role/ecsTaskRole"
}