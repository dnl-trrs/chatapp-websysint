rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the file
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Profile pictures - simplified rules
    match /profilePictures/{userId}/{allPaths=**} {
      // Allow anyone to read profile pictures (public profiles)
      allow read: if true;
      
      // Allow users to upload/update their own profile picture
      allow write: if isOwner(userId);
      
      // Allow users to delete their own profile picture
      allow delete: if isOwner(userId);
    }
    
    // Group chat pictures
    match /groupChats/{groupId}/{allPaths=**} {
      // Allow anyone to read group pictures
      allow read: if true;
      
      // Allow authenticated users to upload (should check membership in app)
      allow write: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // Server icons
    match /servers/{serverId}/{allPaths=**} {
      // Allow anyone to read server icons
      allow read: if true;
      
      // Allow authenticated users to upload (should check ownership/admin in app)
      allow write: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // Channel icons
    match /channels/{channelId}/{allPaths=**} {
      // Allow anyone to read channel icons
      allow read: if true;
      
      // Allow authenticated users to upload (should check permissions in app)
      allow write: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // Default deny all for other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
